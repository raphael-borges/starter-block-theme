	"styles": {
		"blocks": {
			"core/button": {
				"border": {
					"bottom": {
						"style": "none",
						"width": "0px"
					},
					"left": {
						"style": "none",
						"width": "0px"
					},
					"radius": {
						"bottomLeft": "0px",
						"bottomRight": "0px",
						"topLeft": "0px",
						"topRight": "0px"
					},
					"right": {
						"style": "none",
						"width": "0px"
					},
					"top": {
						"style": "none",
						"width": "0px"
					}
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--contrast)"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--contrast)"
						}
					}
				},
				"spacing": {
					"padding": {
						"bottom": "var(--wp--preset--spacing--12)",
						"left": "var(--wp--preset--spacing--24)",
						"right": "var(--wp--preset--spacing--24)",
						"top": "var(--wp--preset--spacing--12)"
					}
				},
				"typography": {
					"fontStyle": "normal",
					"fontWeight": "700",
					"textTransform": "uppercase"
				},
				"variations": {
					"outline": {
						"border": {
							"bottom": {
								"color": "var(--wp--preset--color--primary)",
								"style": "solid",
								"width": "1px"
							},
							"left": {
								"color": "var(--wp--preset--color--primary)",
								"style": "solid",
								"width": "1px"
							},
							"right": {
								"color": "var(--wp--preset--color--primary)",
								"style": "solid",
								"width": "1px"
							},
							"top": {
								"color": "var(--wp--preset--color--primary)",
								"style": "solid",
								"width": "1px"
							}
						},
						"color": {
							"text": "var(--wp--preset--color--contrast)"
						},
						"spacing": {
							"padding": {
								"bottom": "var(--wp--preset--spacing--12)",
								"left": "var(--wp--preset--spacing--24)",
								"right": "var(--wp--preset--spacing--24)",
								"top": "var(--wp--preset--spacing--12)"
							}
						}
					}
				}
			},
			"core/heading": {
				"spacing": {
					"padding": {
						"bottom": "var(--wp--preset--spacing--8)",
						"top": "var(--wp--preset--spacing--4)"
					}
				}
			},
			"core/navigation": {
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--24)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--josefin-sans)",
					"fontSize": "0.9rem",
					"fontStyle": "normal",
					"fontWeight": "700",
					"textTransform": "uppercase"
				}
			},
			"core/paragraph": {
				"spacing": {
					"padding": {
						"bottom": "var(--wp--preset--spacing--8)",
						"top": "0"
					}
				}
			}
		},
		"elements": {
			"button": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--josefin-sans)",
					"fontWeight": "300"
				}
			},
			"caption": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--roboto)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--start-h-1)",
					"fontStyle": "normal",
					"fontWeight": "300",
					"lineHeight": "1",
					"textTransform": "uppercase"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--start-h-2)",
					"fontStyle": "normal",
					"fontWeight": "400",
					"lineHeight": "1.1"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--start-h-3)",
					"fontStyle": "normal",
					"fontWeight": "400",
					"lineHeight": "1.2"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--start-h-4)",
					"fontStyle": "normal",
					"fontWeight": "400",
					"lineHeight": "1.2"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--start-h-5)",
					"fontStyle": "normal",
					"fontWeight": "400",
					"lineHeight": "1.3"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--start-h-6)",
					"fontStyle": "normal",
					"fontWeight": "400",
					"lineHeight": "1.4"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--josefin-sans)",
					"fontStyle": "normal",
					"fontWeight": "300",
					"lineHeight": "1.2"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary-hover)"
				}
			}
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--8)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--roboto)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.6"
		}
	}
}
