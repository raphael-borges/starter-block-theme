{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"custom": false,
			"customDuotone": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": [],
			"palette": [
				{
					"color": "oklch(0.985 0.005 80)",
					"name": "Fundo Areia (Cream)",
					"slug": "base"
				},
				{
					"color": "oklch(0.36 0.018 45)",
					"name": "Terra",
					"slug": "contrast"
				},
				{
					"color": "oklch(0.78 0.025 75)",
					"name": "Areia Escura",
					"slug": "secondary"
				},
				{
					"color": "oklch(0.66 0.11 190)",
					"name": "Verde Água",
					"slug": "accent"
				},
				{
					"color": "oklch(0.93 0.012 75)",
					"name": "Areia Clara (Muted)",
					"slug": "muted"
				},
				{
					"color": "#ffffff",
					"name": "Branco Puro",
					"slug": "white"
				}
			]
		},
		"custom": {
			"blockGap": "var(--wp--preset--spacing--24)"
		},
		"layout": {
			"contentSize": "1440px",
			"wideSize": "100%"
		},
		"shadow": {
			"presets": []
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "2X-Small",
					"size": "clamp(0.125rem, 10vw, 0.125rem)",
					"slug": "2"
				},
				{
					"name": "X-Small",
					"size": "clamp(0.2rem, 10vw, 0.25rem)",
					"slug": "4"
				},
				{
					"name": "Small",
					"size": "clamp(0.4rem, 10vw, 0.5rem)",
					"slug": "8"
				},
				{
					"name": "Medium",
					"size": "clamp(.75em, 10vw, 1rem)",
					"slug": "16"
				},
				{
					"name": "Large",
					"size": "clamp(1.25rem, 10vw, 1.5rem)",
					"slug": "24"
				},
				{
					"name": "X-Large",
					"size": "clamp(1.75rem, 10vw, 2rem)",
					"slug": "32"
				},
				{
					"name": "2X-Large",
					"size": "clamp(3rem, 10vw , 4rem)",
					"slug": "64"
				}
			]
		},
		"typography": {
			"customFontSize": true,
			"defaultFontSizes": false,
			"dropCap": false,
			"fontFamilies": [
				{
					"fontFace": [
						{
							"fontFamily": "Atelia",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": ["file:./assets/fonts/atelia/atelia-400-normal.woff2"],
							"fontDisplay": "swap"
						}
					],
					"fontFamily": "Atelia, sans-serif",
					"name": "Atelia",
					"slug": "atelia"
				},
				{
					"fontFamily": "ui-sans-serif, system-ui, -apple-system, Helvetica Neue, Helvetica, Arial, sans-serif",
					"name": "System Sans",
					"slug": "sans"
				}
			],
			"fontSizes": [
				{
					"fluid": false,
					"name": "Tiny (Eyebrow)",
					"size": "0.7rem",
					"slug": "tiny"
				},
				{
					"fluid": {
						"max": "1.05rem",
						"min": "0.95rem"
					},
					"name": "Body",
					"size": "1.05rem",
					"slug": "base"
				},
				{
					"fluid": {
						"max": "1.15rem",
						"min": "1rem"
					},
					"name": "H6",
					"size": "1.15rem",
					"slug": "start-h6"
				},
				{
					"fluid": {
						"max": "1.5rem",
						"min": "1.15rem"
					},
					"name": "H5",
					"size": "1.5rem",
					"slug": "start-h5"
				},
				{
					"fluid": {
						"max": "1.5rem",
						"min": "1.25rem"
					},
					"name": "H4",
					"size": "1.5rem",
					"slug": "start-h4"
				},
				{
					"fluid": {
						"max": "1.75rem",
						"min": "1.5rem"
					},
					"name": "H3",
					"size": "1.75rem",
					"slug": "start-h3"
				},
				{
					"fluid": {
						"max": "2.25rem",
						"min": "1.75rem"
					},
					"name": "H2",
					"size": "2.25rem",
					"slug": "start-h2"
				},
				{
					"fluid": {
						"max": "2.72rem",
						"min": "2rem"
					},
					"name": "H1",
					"size": "2.72rem",
					"slug": "start-h1"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"blocks": {
			"core/accordion": {
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--16)",
					"margin": {
						"bottom": "0",
						"top": "0"
					},
					"padding": {
						"bottom": "0",
						"left": "0",
						"right": "0",
						"top": "0"
					}
				}
			},
			"core/button": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--atelia)"
				}
			},
			"core/column": {
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--24)",
					"padding": {
						"bottom": "0",
						"left": "0",
						"right": "0",
						"top": "0"
					}
				}
			},
			"core/columns": {
				"spacing": {
					"blockGap": {
						"left": "var(--wp--preset--spacing--16)",
						"top": "var(--wp--preset--spacing--8)"
					},
					"margin": {
						"bottom": "0",
						"top": "0"
					},
					"padding": {
						"bottom": "0",
						"left": "0",
						"right": "0",
						"top": "0"
					}
				}
			},
			"core/group": {
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--16)",
					"margin": {
						"bottom": "0",
						"top": "0"
					},
					"padding": {
						"bottom": "var(--wp--preset--spacing--64)",
						"left": "var(--wp--preset--spacing--16)",
						"right": "var(--wp--preset--spacing--16)",
						"top": "var(--wp--preset--spacing--64)"
					}
				}
			},
			"core/paragraph": {
				"spacing": {
					"margin": {
						"bottom": "var(--wp--preset--spacing--8)",
						"top": "var(--wp--preset--spacing--8)"
					}
				}
			}
		},
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"elements": {
			"button": {
				":active": {
					"color": {
						"background": "var(--wp--preset--color--base)",
						"text": "var(--wp--preset--color--contrast)"
					}
				},
				":focus": {
					"border": {
						"color": "var(--wp--preset--color--base)"
					},
					"color": {
						"background": "var(--wp--preset--color--contrast)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--contrast)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				":visited": {
					"color": {
						"text": "var(--wp--preset--color--base)"
					}
				},
				"border": {
					"color": "var(--wp--preset--color--contrast)",
					"radius": "0px",
					"width": "1px"
				},
				"color": {
					"background": "var(--wp--preset--color--contrast)",
					"text": "var(--wp--preset--color--base)"
				},
				"spacing": {
					"padding": {
						"bottom": "var(--wp--preset--spacing--8)",
						"left": "var(--wp--preset--spacing--24)",
						"right": "var(--wp--preset--spacing--24)",
						"top": "var(--wp--preset--spacing--8)"
					}
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--atelia)",
					"fontSize": "var(--wp--preset--font-size--start-h-1)",
					"fontWeight": "400",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.2"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--atelia)",
					"fontSize": "var(--wp--preset--font-size--start-h-2)",
					"fontWeight": "400",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.2"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--atelia)",
					"fontSize": "var(--wp--preset--font-size--start-h-3)",
					"fontWeight": "600",
					"letterSpacing": "0",
					"lineHeight": "1.2"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--atelia)",
					"fontSize": "var(--wp--preset--font-size--start-h-4)",
					"lineHeight": "1.3"
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--atelia)",
					"fontSize": "var(--wp--preset--font-size--start-h-5)",
					"lineHeight": "1.4"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--atelia)",
					"fontSize": "var(--wp--preset--font-size--start-h-6)",
					"lineHeight": "1.5"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--atelia)",
					"fontWeight": "600",
					"lineHeight": "0.95"
				}
			},
			"link": {
				":active": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					},
					"typography": {
						"textDecoration": "none"
					}
				},
				":focus": {
					"typography": {
						"textDecoration": "underline dashed"
					}
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"textDecoration": "underline"
				}
			}
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--16)",
			"padding": {
				"left": "var(--wp--preset--spacing--16)",
				"right": "var(--wp--preset--spacing--16)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"fontWeight": "300",
			"lineHeight": "1.65"
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer Credit Area"
		}
	]
}
