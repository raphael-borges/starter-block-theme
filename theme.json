				}
			]
		},
		"spacing": {
			"customSpacingSize": true,
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "3X-Small",
					"size": "clamp(0.25rem, 1vw, 0.375rem)",
