{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "starter-block-theme/section-trajectory",
  "version": "1.0.0",
  "title": "Sessão — Trajetória",
  "category": "start-category",
  "icon": "chart-line",
  "description": "Sessão 03 — Trajetória.",
  "keywords": [
    "trajetória",
    "trajectory",
    "carreira",
    "sessão"
  ],
  "textdomain": "starter-block-theme",
  "parent": [
    "starter-block-theme/spatial-canvas"
  ],
  "supports": {
    "interactivity": true,
    "html": false,
    "multiple": false,
    "reusable": false,
    "anchor": true
  },
  "attributes": {
    "sectionTitle": {
      "type": "string",
      "default": "Trajetória"
    },
    "sectionNumber": {
      "type": "string",
      "default": "03"
    },
    "slideCount": {
      "type": "number",
      "default": 4
    }
  },
  "render": "file:./render.php",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}