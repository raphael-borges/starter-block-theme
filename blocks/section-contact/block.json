{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "starter-block-theme/section-contact",
  "version": "1.0.0",
  "title": "Sessão — Contato",
  "category": "start-category",
  "icon": "email",
  "description": "Sessão 05 — Contato.",
  "keywords": [
    "contato",
    "contact",
    "whatsapp",
    "sessão"
  ],
  "textdomain": "starter-block-theme",
  "parent": [
    "starter-block-theme/spatial-canvas"
  ],
  "supports": {
    "interactivity": true,
    "html": false,
    "multiple": false,
    "reusable": false,
    "anchor": true
  },
  "attributes": {
    "sectionTitle": {
      "type": "string",
      "default": "Contato"
    },
    "sectionNumber": {
      "type": "string",
      "default": "05"
    },
    "slideCount": {
      "type": "number",
      "default": 1
    }
  },
  "render": "file:./render.php",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}