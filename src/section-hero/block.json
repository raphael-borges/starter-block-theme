{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "starter-block-theme/section-hero",
	"version": "1.0.0",
	"title": "Sessão — Hero (Início)",
	"category": "start-category",
	"icon": "cover-image",
	"description": "Sessão 01 — Início.",
	"keywords": ["hero", "início", "home", "sessão"],
	"textdomain": "starter-block-theme",
	"parent": ["starter-block-theme/spatial-canvas"],
	"supports": {
		"interactivity": true,
		"html": false,
		"multiple": false,
		"reusable": false,
		"anchor": true
	},
	"attributes": {
		"sectionTitle":  { "type": "string", "default": "Início" },
		"sectionNumber": { "type": "string", "default": "01" },
		"slideCount":    { "type": "number", "default": 1 }
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
